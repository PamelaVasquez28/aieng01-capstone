{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Abrir la guía del lab (GUIA.md)",
      "type": "shell",
      "command": "command -v code >/dev/null 2>&1 && code -r GUIA.md || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
